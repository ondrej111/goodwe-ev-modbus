{
  "config": {
    "step": {
      "user": {
        "title": "GoodWe EV Charger",
        "description": "Connect to your GoodWe EV charger via Modbus TCP.",
        "data": {
          "host": "IP Address",
          "port": "Port",
          "unit_id": "Modbus Unit ID"
        }
      },
      "reconfigure": {
        "title": "GoodWe EV Charger",
        "description": "Update the charger's network address, port or Modbus unit ID. The connection is tested before the change is saved.",
        "data": {
          "host": "IP Address",
          "port": "Port",
          "unit_id": "Modbus Unit ID"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot connect to the charger. Check the IP address and port.",
      "invalid_response": "Connected but no valid response. Check the Modbus Unit ID (default: 247)."
    },
    "abort": {
      "already_configured": "This charger is already configured.",
      "reconfigure_successful": "Charger connection details updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Polling",
        "description": "How often the charger is read, and how long to pause between the two Modbus block reads in each poll.",
        "data": {
          "scan_interval_active": "Active poll interval (seconds)",
          "scan_interval_idle": "Idle poll interval (seconds)",
          "read_delay": "Delay between block reads (seconds)",
          "active_backoff": "Backoff after a fault (seconds)",
          "release_when_idle": "Release the connection when nothing is plugged in"
        },
        "data_description": {
          "scan_interval_active": "Used while a cable is connected, handshaking, or charging.",
          "scan_interval_idle": "Used only when nothing is plugged in.",
          "read_delay": "Paces consecutive Modbus requests. Raise this if the charger drops reads.",
          "active_backoff": "How long to wait before retrying when a cable is connected but the read fails or the charger reports a fault.",
          "release_when_idle": "Closes the Modbus socket after each idle poll so the charger's cloud uplink can use it, letting the charger appear in the SEMS app. The connection is held open continuously whenever a cable is connected."
        }
      }
    }
  },
